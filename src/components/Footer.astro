---

import  { Image } from 'astro:assets';
import logo from '../assets/logo-r4w.png';
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: "Accueil", href: "#accueil" },
  { label: "Services", href: "#services" },
  { label: "À propos", href: "#a-propos" },
  { label: "Contact", href: "#contact" },
];

const socials = [
  { label: "LinkedIn", href: "https://linkedin.com/company/TODO" },
  { label: "Instagram", href: "https://instagram.com/TODO" },
];
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-brand">
           <Image src={logo} alt="Ready 4 Work" width={180} height={100} />

      <p>Votre tremplin vers l'emploi.</p>
    </div>

    <nav class="footer-links" aria-label="Liens rapides">
      <h3>Navigation</h3>
      <ul>
        {quickLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-contact">
      <h3>Contact</h3>
      <ul>
        <li><a href="mailto:contact@TODO.fr">contact@TODO.fr</a></li>
        <li><a href="tel:+33600000000">06 00 00 00 00</a></li>
      </ul>
    </div>

    <div class="footer-socials">
      <h3>Suivez-nous</h3>
      <div class="socials-icons">
        <a href={socials[0].href} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.11 20.45H3.56V9h3.55v11.45z"/>
          </svg>
        </a>
        <a href={socials[1].href} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.39C1.35 2.68.94 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.39 2.13.67.67 1.34 1.08 2.13 1.39.76.3 1.64.5 2.91.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.39.67-.67 1.08-1.34 1.39-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.39-2.13C21.32 1.35 20.65.94 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} Ready 4 Work. Tous droits réservés.</p>
    <div class="footer-legal">
      <a href="/mentionsLegales">Mentions légales</a>
      <a href="/politiquesConfidentialite">Confidentialité</a>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/variables' as variables;

  .footer {
    background-color: variables.$color-primary-dark;
    color: white;
    padding: variables.$spacing-xl variables.$spacing-md variables.$spacing-md;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: variables.$spacing-lg;
    padding-bottom: variables.$spacing-lg;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-brand {
    .footer-logo {
      height: 40px;
      margin-bottom: variables.$spacing-sm;
    }

    p {
      color: rgba(255, 255, 255, 0.7);
      font-size: variables.$font-size-base;
    }
  }

  .footer-links,
  .footer-contact,
  .footer-socials {
    h3 {
      font-size: variables.$font-size-base;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: variables.$spacing-sm;
      color: rgba(255, 255, 255, 0.9);
    }

    ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: variables.$spacing-xs;
    }

    a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover {
        color: variables.$color-gray;
      }
    }
  }

  .socials-icons {
    display: flex;
    gap: variables.$spacing-sm;

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: rgba(255, 255, 255, 0.1);
      color: white;
      text-decoration: none;
      transition: background-color 0.2s ease;

      &:hover {
        background-color: variables.$color-gray;
      }
    }
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: variables.$spacing-md;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: variables.$spacing-sm;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);

    .footer-legal {
      display: flex;
      gap: variables.$spacing-md;

      a {
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;

        &:hover {
          color: white;
        }
      }
    }
  }

  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>