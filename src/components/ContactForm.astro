<form id="contact-form">
  <h1>Prenons rendez-vous !</h1>

  <label for="lastname">Nom :</label>
  <input type="text" id="lastname" name="lastname" placeholder="Votre nom" required />

  <label for="firstname">Prénom :</label>
  <input type="text" id="firstname" name="firstname" placeholder="Votre prénom" required />

  <label for="job">Fonction :</label>
  <input type="text" id="job" name="job" placeholder="Votre fonction" required />

  <label for="email">Email :</label>
  <input type="email" id="email" name="email" placeholder="Votre adresse mail" required />

  <label for="phone">Numéro de téléphone :</label>
  <input
    type="tel"
    id="phone"
    name="phone"
    placeholder="ex : 06 02 20 10 40"
    pattern="0[1-9](?: [0-9]{2}){4}"
    required
  />

  <label for="place">Votre établissement :</label>
  <input type="text" id="place" name="place" placeholder="Votre établissement" required />

  <label for="city">Votre ville :</label>
  <input type="text" id="city" name="city" placeholder="Votre ville" required />

  <label for="message">Votre demande :</label>
  <textarea name="message" id="message" rows="5" required></textarea>

  <button type="submit" class="btn-primary" id="submit-btn">Envoyer</button>

  <!-- Zone de feedback dynamique -->
  <p id="form-feedback" role="status" aria-live="polite"></p>
</form>

<style lang="scss">
  @use "../styles/_variables.scss";

  form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 600px;
    margin: 55px auto;
  }

  h1 {
    align-self: center;
  }

  label {
    font-weight: 600;
    color: variables.$color-gray-dark;
  }

  input,
  textarea {
    padding: 0.75rem 1rem;
    border: 1px solid variables.$color-gray;
    border-radius: 5px;
    font-family: variables.$font-body;
    font-size: 1rem;
    transition: border-color 0.2s ease;

    &:focus {
      outline: none;
      border-color: variables.$color-accent-yellow;
    }
  }

  #form-feedback {
    text-align: center;
    font-weight: 600;
    min-height: 1.5rem;

    &.success {
      color: green;
    }

    &.error {
      color: crimson;
    }
  }

  button[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>